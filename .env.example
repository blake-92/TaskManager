# Variables para levantar todo el proyecto con Docker Compose (ver README).
# Copia este archivo a .env: los valores de ejemplo sirven para una prueba local.
# El .env real nunca se sube a git.

# Base de datos (servicio postgres). docker-compose.yml arma con estos valores la
# DATABASE_URL que recibe el backend, con "postgres" como host.
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppass
POSTGRES_DB=appdb

# Backend: secreto con el que se firman los tokens de sesión.
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# Frontend: en local no hace falta; sin VITE_API_URL el frontend usa http://localhost:3000.
# En la nube, descoméntalo con la URL pública del backend (Vite solo expone variables VITE_).
# VITE_API_URL="https://tu-backend.onrender.com"
